[Unit]
Description=midibridge — X-Touch Extender to XR18 OSC bridge
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=admin
Group=admin
WorkingDirectory=/home/admin/midibridge
ExecStart=/home/admin/midibridge/.venv/bin/python3 /home/admin/midibridge/bridge.py
Restart=always
RestartSec=3

# Stdout/stderr go to journalctl
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
